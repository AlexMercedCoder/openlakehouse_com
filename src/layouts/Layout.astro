---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const { 
  title,
  description = "OpenDataLakehouse is the definitive vendor-neutral publication for Data Lakehouse architecture, Apache Iceberg, and Agentic AI.",
  image = "https://opendatalakehouse.com/og-image.png",
  type = "website"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://opendatalakehouse.com');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "OpenDataLakehouse",
  "url": "https://opendatalakehouse.com/",
  "description": description,
  "publisher": {
    "@type": "Person",
    "@id": "https://alexmerced.com/#alexmerced",
    "name": "Alex Merced",
    "url": "https://alexmerced.com",
    "sameAs": [
      "https://whoisalexmerced.com",
      "https://alexmerced.com",
      "https://alexmerceddata.com",
      "https://www.linkedin.com/in/alexmerced"
    ]
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | OpenDataLakehouse</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  
  <meta property="og:title" content={`${title} | OpenDataLakehouse`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content={type} />
  <meta property="og:image" content={image} />
  
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@alexmercedcoder" />
  <meta name="twitter:title" content={`${title} | OpenDataLakehouse`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600&family=Space+Mono&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      color-scheme: light;
      /* Colors */
      --color-canvas-white: #ffffff;
      --color-midnight-black: #000000;
      --color-subtle-gray: #6b6b6b; /* AA-compliant on white (5.3:1) — was #b7b7b7 (2.3:1) */
      --color-anchor-gray: #333333;
      --color-faded-gray: #5f5f5f; /* AA-compliant on white (6.4:1) — was #858585 (3.5:1) */
      --color-hairline: #e0e0e0; /* decorative borders only (not text) */

      /* Typography */
      --font-body: 'Inter', ui-sans-serif, system-ui, sans-serif;
      --font-display: 'Bebas Neue', sans-serif;
      --font-mono: 'Space Mono', monospace;

      /* Scale */
      --text-caption: 12px;
      --text-body: 14px;
      --text-body-lg: 16px;
      --text-display-sm: 48px; /* Adjusted for web practicality */
      --text-display: 80px; /* Adjusted for web practicality */

      /* Spacing */
      --spacing-12: 12px;
      --spacing-16: 16px;
      --spacing-20: 20px;
      --spacing-24: 24px;
      --spacing-36: 36px;
      --spacing-64: 64px;

      /* Radii */
      --radius-sm: 2px;
      --radius-md: 6px;
    }

    /* Base Reset */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* Accessibility: skip-link + visible focus outline */
    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0;
      z-index: 1000;
      padding: 12px 20px;
      background: var(--color-midnight-black);
      color: var(--color-canvas-white);
      font-family: var(--font-body);
      font-weight: 600;
      text-decoration: none;
    }
    .skip-link:focus {
      left: 0;
    }
    :focus-visible {
      outline: 3px solid var(--color-midnight-black);
      outline-offset: 2px;
    }

    body {
      font-family: var(--font-body);
      background-color: var(--color-canvas-white);
      color: var(--color-midnight-black);
      line-height: 1.5;
      font-size: var(--text-body-lg);
      -webkit-font-smoothing: antialiased;
    }

    /* Typography */
    h1, h2, h3, h4 {
      font-family: var(--font-display);
      text-transform: uppercase;
      letter-spacing: -0.01em;
      line-height: 1.1;
      margin-bottom: var(--spacing-20);
    }

    h1 {
      font-size: var(--text-display);
      letter-spacing: -2px;
    }

    h2 {
      font-size: var(--text-display-sm);
    }

    a {
      color: var(--color-midnight-black);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    a:hover {
      color: var(--color-faded-gray);
    }

    /* Structure */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--spacing-24);
    }

    /* Header Nav */
    .site-header {
      position: sticky;
      top: 0;
      background: var(--color-canvas-white);
      border-bottom: 1px solid var(--color-midnight-black);
      z-index: 100;
      padding: var(--spacing-16) 0;
    }

    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      font-family: var(--font-display);
      font-size: 32px;
      letter-spacing: 1px;
    }

    .nav-links {
      display: flex;
      gap: var(--spacing-24);
    }

    .nav-links a {
      font-size: var(--text-body);
      font-weight: 500;
      padding: var(--spacing-12);
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--color-midnight-black);
      color: var(--color-canvas-white);
      padding: var(--spacing-16) var(--spacing-36);
      border-radius: var(--radius-md);
      font-family: var(--font-body);
      font-weight: 600;
      border: 2px solid var(--color-midnight-black);
      cursor: pointer;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.2s ease;
    }
    .btn:hover {
      background: var(--color-canvas-white);
      color: var(--color-midnight-black);
    }

    .btn-ghost {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      color: var(--color-midnight-black);
      border: 2px solid var(--color-midnight-black);
      padding: var(--spacing-16) var(--spacing-36);
      border-radius: var(--radius-md);
      font-family: var(--font-body);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.2s ease;
    }
    .btn-ghost:hover {
      background: var(--color-midnight-black);
      color: var(--color-canvas-white);
    }

    /* Search Input */
    input[type="search"] {
      background: var(--color-canvas-white);
      border: 1px solid var(--color-midnight-black);
      color: var(--color-midnight-black);
      padding: var(--spacing-12) var(--spacing-16);
      font-family: var(--font-body);
      font-size: var(--text-body);
      border-radius: 0; /* Brutalist approach based on design.md focus */
      width: 100%;
      outline: none;
    }
    input[type="search"]:focus {
      border-width: 2px;
      padding: 11px 15px; /* Adjust for border */
    }
    
    /* Layout Utilities */
    .section {
      padding: var(--spacing-64) 0;
    }

    /* Footer */
    .site-footer {
      border-top: 1px solid var(--color-midnight-black);
      padding: var(--spacing-36) 0;
      margin-top: var(--spacing-64);
    }
    
    .footer-inner {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-20);
    }
    
    @media (min-width: 768px) {
      .footer-inner {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
    }

    .footer-brand {
      font-family: var(--font-display);
      font-size: 24px;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-20);
    }

    .footer-links a {
      font-size: var(--text-body);
      color: var(--color-anchor-gray);
      font-weight: 500;
    }

    .footer-links a:hover {
      text-decoration: underline;
      color: var(--color-midnight-black);
    }

    /* Note: To strictly adhere to the monochromatic design, dark mode is disabled 
       in favor of the stark white/black contrast requested by the Studio Few aesthetic. */
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <header class="site-header">
    <div class="container nav-inner">
      <a href="/" class="brand">OpenDataLakehouse</a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/kb">Knowledge Base</a>
        <a href="/blogs">Blog Roll</a>
        <a href="/videos">Videos</a>
        <a href="/books">Book Roll</a>
      </nav>
    </div>
  </header>
  <main id="main-content">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">OpenDataLakehouse</div>
      <nav class="footer-links">
        <a href="https://datalakehousehub.com" target="_blank" rel="noopener noreferrer">datalakehousehub.com</a>
        <a href="https://datalakehouse.help" target="_blank" rel="noopener noreferrer">datalakehouse.help</a>
        <a href="https://dataengnr.com" target="_blank" rel="noopener noreferrer">dataengnr.com</a>
        <a href="https://iceberglakehouse.com" target="_blank" rel="noopener noreferrer">iceberglakehouse.com</a>
        <a href="https://alexmerceddata.com" target="_blank" rel="noopener noreferrer">alexmerceddata.com</a>
        <a href="https://alexmerced.com" target="_blank" rel="noopener noreferrer">alexmerced.com</a>
        <a href="https://books.alexmerced.com" target="_blank" rel="noopener noreferrer">books.alexmerced.com</a>
      </nav>
    </div>
  </footer>
  <!-- WebMCP: read-only tools for browser AI agents. Progressive enhancement;
       no effect where WebMCP is unsupported. Config in /webmcp/init.js -->
  <script src="/webmcp/alex-merced-webmcp.js" defer></script>
  <script src="/webmcp/init.js" defer></script>
</body>
</html>
