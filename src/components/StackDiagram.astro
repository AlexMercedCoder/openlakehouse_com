---
/**
 * The hero illustration: the definition in the adjacent text, drawn.
 *
 * Open formats on object storage, a table format over them, one catalog above
 * that, and several engines attached to the catalog rather than owning the
 * data. The build-in runs bottom to top because that is the order the stack is
 * assembled, and the flow along the engine connectors is what "any compliant
 * engine can read and write it" looks like.
 *
 * Colours come from the layer tokens, so the diagram is the same colour system
 * used everywhere else on the site and follows both themes.
 *
 * Every animation is CSS rather than SMIL, so the site-wide
 * prefers-reduced-motion rule switches it off along with everything else. The
 * final frame is also the resting state, so a viewer who never sees the motion
 * sees the finished diagram.
 *
 * Geometry is computed from the engine list rather than hand-placed, so adding
 * or removing an engine re-centres the whole diagram instead of requiring every
 * coordinate to be recalculated by hand.
 */

const ENGINES = ['Spark', 'Trino', 'Flink', 'DuckDB', 'SAP/Dremio'];

const VB_W = 560;          // viewBox width
const CX = VB_W / 2;       // the spine everything centres on

const E_W = 96, E_GAP = 10, E_Y = 18, E_H = 30;
const eSpan = ENGINES.length * E_W + (ENGINES.length - 1) * E_GAP;
const eX0 = (VB_W - eSpan) / 2;
const engines = ENGINES.map((label, i) => {
  const x = eX0 + i * (E_W + E_GAP);
  return { label, x, cx: x + E_W / 2, i };
});

const FILE_N = 4, F_W = 88, F_GAP = 14, F_Y = 236, F_H = 28;
const fSpan = FILE_N * F_W + (FILE_N - 1) * F_GAP;
const files = Array.from({ length: FILE_N }, (_, i) => (VB_W - fSpan) / 2 + i * (F_W + F_GAP));

const CAT_W = 210, TAB_W = 420, STO_W = 490;

/**
 * Route an engine down to the catalog. The engine sitting directly above the
 * spine drops straight down; the others step inward at y=96 before meeting it.
 */
function wire(cx: number): string {
  if (Math.abs(cx - CX) < 0.5) return `M ${CX} ${E_Y + E_H} L ${CX} 110`;
  const dir = cx > CX ? -1 : 1;
  const turn = cx + dir * 14;
  const meet = CX - dir * 14;
  return `M ${cx} ${E_Y + E_H} L ${cx} 82 Q ${cx} 96 ${turn} 96 L ${meet} 96 Q ${CX} 96 ${CX} 110`;
}
---

<figure class="stack-fig">
  <svg viewBox={`0 0 ${VB_W} 336`} role="img"
       aria-label={`An open lakehouse drawn as layers: open file formats on object storage, a table format above them, a catalog above that, and ${ENGINES.length} query engines attached to the catalog: ${ENGINES.join(', ')}.`}>
    <defs>
      <!-- Flow along the engine connectors, drawn as a moving dash. -->
      <linearGradient id="flowFade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--layer-compute)" stop-opacity="0" />
        <stop offset="50%" stop-color="var(--layer-compute)" stop-opacity="1" />
        <stop offset="100%" stop-color="var(--layer-compute)" stop-opacity="0" />
      </linearGradient>
    </defs>

    <!-- Engines -->
    <g class="tier tier-engines">
      {engines.map((e) => (
        <g class="node engine" style={`--i:${e.i}`}>
          <rect x={e.x} y={E_Y} width={E_W} height={E_H} rx="2" />
          <text x={e.cx} y={E_Y + 20}>{e.label}</text>
        </g>
      ))}
    </g>

    <!-- Engine connectors, drawn in, then carrying flow -->
    <g class="connectors" aria-hidden="true">
      {engines.map((e) => (
        <>
          <path class="wire" style={`--i:${e.i}`} d={wire(e.cx)} />
          <path class="flow" style={`--i:${e.i}`} d={wire(e.cx)} />
        </>
      ))}
    </g>

    <!-- Catalog -->
    <g class="tier tier-catalog">
      <g class="node catalog">
        <rect x={CX - CAT_W / 2} y="112" width={CAT_W} height="34" rx="2" />
        <text x={CX} y="134">Catalog</text>
      </g>
    </g>

    <!-- Spine between the lower layers -->
    <g class="spine" aria-hidden="true">
      <path class="wire spine-1" d={`M ${CX} 146 L ${CX} 178`} />
      <path class="wire spine-2" d={`M ${CX} 212 L ${CX} ${F_Y}`} />
    </g>

    <!-- Table format -->
    <g class="tier tier-table">
      <g class="node table-format">
        <rect x={CX - TAB_W / 2} y="178" width={TAB_W} height="34" rx="2" />
        <text x={CX} y="200">Table format</text>
      </g>
    </g>

    <!-- Data files sitting on storage -->
    <g class="tier tier-files">
      {files.map((x, i) => (
        <g class="file" style={`--i:${i}`}>
          <rect x={x} y={F_Y} width={F_W} height={F_H} rx="1" />
          <text x={x + F_W / 2} y={F_Y + 18}>Data file</text>
        </g>
      ))}
    </g>

    <!-- Object storage -->
    <g class="tier tier-storage">
      <g class="node storage">
        <rect x={CX - STO_W / 2} y="276" width={STO_W} height="42" rx="2" />
        <text x={CX} y="302">Object storage you control</text>
      </g>
    </g>
  </svg>
</figure>

<style>
  .stack-fig { margin: 0; width: 100%; }
  .stack-fig svg { width: 100%; height: auto; display: block; overflow: visible; }

  /* Shared node styling, coloured per tier below. */
  .node rect {
    fill: var(--surface);
    stroke: var(--tier-hue);
    stroke-width: 1.5;
  }
  .node text {
    fill: var(--tier-hue);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-anchor: middle;
    text-transform: uppercase;
  }

  /* The SVG scales with its container, so on a phone the labels would shrink
     below readability. Raising the font size instead would overflow the fixed
     boxes, so the diagram keeps a minimum width and scrolls within its own
     figure, the way wide tables do elsewhere on the site. The page itself
     never scrolls sideways. */
  @media (max-width: 640px) {
    .stack-fig {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      padding-bottom: 4px;
    }
    .stack-fig svg { min-width: 560px; }  /* the diagram's natural width, so labels render at full size */
  }

  .tier-engines { --tier-hue: var(--layer-compute); }
  .tier-catalog { --tier-hue: var(--layer-catalog); }
  .tier-table   { --tier-hue: var(--layer-table); }
  .tier-files   { --tier-hue: var(--layer-storage); }
  .tier-storage { --tier-hue: var(--layer-storage); }

  .file rect {
    fill: var(--surface);
    stroke: var(--layer-storage);
    stroke-width: 1.5;
  }
  /* A step below the tier labels: these repeat four times and should read as
     texture rather than compete with the layer names. */
  .file text {
    fill: var(--layer-storage);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-anchor: middle;
    text-transform: uppercase;
  }

  .wire {
    fill: none;
    stroke: var(--hairline-strong);
    stroke-width: 1.25;
    opacity: 0.5;
  }

  /* The moving dash that reads as data crossing the connector. */
  .flow {
    fill: none;
    stroke: url(#flowFade);
    stroke-width: 2;
    stroke-dasharray: 16 150;
    stroke-linecap: round;
  }

  /* ---------------------------------------------------------------- motion */
  /* Elements are laid out in their final position; the animations only add
     entrance movement, so the resting state is the correct one. */
  .node, .file {
    transform-box: fill-box;
    transform-origin: center;
    animation: rise 620ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* Bottom to top, the order the stack is assembled. */
  .tier-storage .node { animation-delay: 60ms; }
  .tier-files .file   { animation-delay: calc(220ms + var(--i) * 55ms); }
  .tier-table .node   { animation-delay: 600ms; }
  .tier-catalog .node { animation-delay: 780ms; }
  .tier-engines .engine { animation-delay: calc(960ms + var(--i) * 90ms); }

  @keyframes rise {
    from { opacity: 0; transform: translateY(9px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Connectors draw themselves after the nodes they join have arrived. */
  .spine .wire, .connectors .wire {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: draw 520ms ease-out forwards;
  }
  /* These need the same specificity as the rule above, whose `animation`
     shorthand resets delay to 0 and would otherwise win. */
  .spine .spine-1 { animation-delay: 700ms; }
  .spine .spine-2 { animation-delay: 520ms; }
  .connectors .wire { animation-delay: calc(1040ms + var(--i) * 90ms); }

  @keyframes draw { to { stroke-dashoffset: 0; } }

  /* Flow starts only once everything is in place, then repeats slowly. */
  .flow {
    stroke-dashoffset: 166;
    opacity: 0;
    animation:
      flowIn 1ms linear 1500ms forwards,
      flow 3.4s linear infinite 1500ms;
  }
  .connectors .flow { animation-delay: 1500ms, calc(1500ms + var(--i) * 850ms); }

  @keyframes flowIn { to { opacity: 1; } }
  @keyframes flow { from { stroke-dashoffset: 166; } to { stroke-dashoffset: -16; } }

  /* The site-wide reduced-motion rule collapses durations, which would leave
     the looping flow flickering. Remove it outright instead. */
  @media (prefers-reduced-motion: reduce) {
    .flow { display: none; }
    .node, .file, .spine .wire, .connectors .wire {
      animation: none;
      opacity: 1;
      stroke-dashoffset: 0;
    }
  }
</style>
