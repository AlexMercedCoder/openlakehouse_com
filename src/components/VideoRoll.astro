---
import videos from '../data/videos.json';
---

<section class="video-roll">
  <div class="video-roll-header">
    <input type="search" id="video-search" class="search-input" placeholder="Search videos..." aria-label="Search videos" />
  </div>
  <div class="video-grid">
    {videos.map((video) => (
      <a href={video.url} target="_blank" rel="noopener noreferrer" class="video-card">
        <img src={video.thumbnail} alt={video.title} loading="lazy" />
        <div class="video-info">
          <h3 class="video-title">{video.title}</h3>
        </div>
      </a>
    ))}
  </div>
</section>

<script>
  const videoSearchInput = document.getElementById('video-search') as HTMLInputElement | null;
  const videoCards = document.querySelectorAll('.video-card');

  if (videoSearchInput) {
    videoSearchInput.addEventListener('input', (e) => {
      const term = (e.target as HTMLInputElement).value.toLowerCase();
      videoCards.forEach(card => {
        const title = card.querySelector('.video-title')?.textContent?.toLowerCase() || '';
        if (title.includes(term)) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  }
</script>

<style>
  .video-roll {
    margin: var(--spacing-20) 0;
  }

  .video-roll-header {
    margin-bottom: var(--spacing-24);
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--spacing-24);
  }

  .video-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-midnight-black);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-canvas-white);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .video-card:hover {
    box-shadow: 4px 4px 0 var(--color-midnight-black);
    transform: translate(-2px, -2px);
  }

  .video-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-bottom: 1px solid var(--color-midnight-black);
    filter: grayscale(100%);
    transition: filter 0.3s;
  }

  .video-card:hover img {
    filter: grayscale(0%);
  }

  .video-info {
    padding: var(--spacing-16);
  }

  .video-info h3 {
    margin: 0;
    font-size: var(--text-body-lg);
    font-family: var(--font-body);
    font-weight: 500;
    text-transform: none;
    line-height: 1.4;
  }
</style>
