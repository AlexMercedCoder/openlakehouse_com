---
/**
 * The open lakehouse drawn as the stack it is, bottom to top.
 *
 * Each row is a layer: its hue, the question it answers, the technologies that
 * occupy it, and how many reference entries cover it. Built as semantic markup
 * rather than an image so it stays readable, linkable, and crawlable.
 */
import { LAYERS, STACK_LAYER_IDS } from '../data/layers';

interface Props {
  /** Entry counts per layer id, when available. */
  counts?: Record<string, number>;
  /** Only the six canonical stack layers, omitting surrounding concerns. */
  stackOnly?: boolean;
  compact?: boolean;
}

const { counts = {}, stackOnly = false, compact = false } = Astro.props;

const rows = (stackOnly ? LAYERS.filter(l => STACK_LAYER_IDS.includes(l.id)) : LAYERS)
  .slice()
  .sort((a, b) => b.order - a.order); // drawn top-down, so storage sits at the base
---

<ol class="stack" class:list={[{ compact }]} data-reveal>
  {rows.map((layer) => (
    <li class="row" style={`--layer-hue: var(--layer-${layer.id}); --i:${rows.indexOf(layer)}`}>
      <a href={`/kb/layer/${layer.id}`} class="row-link">
        <span class="bar" aria-hidden="true"></span>
        <span class="body">
          <span class="head">
            <span class="name">{layer.label}</span>
            {counts[layer.id] !== undefined && (
              <span class="count">{counts[layer.id]} entries</span>
            )}
          </span>
          {!compact && <span class="question">{layer.question}</span>}
          <span class="exemplars">
            {layer.exemplars.map((e) => <span class="tech">{e}</span>)}
          </span>
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .stack {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 3px;
    counter-reset: none;
  }

  .row-link {
    display: grid;
    grid-template-columns: 5px 1fr;
    gap: 0;
    background: var(--surface);
    border: 1px solid var(--hairline);
    transition: border-color .15s ease, transform .15s ease;
  }
  .row-link:hover {
    border-color: var(--layer-hue);
    transform: translateX(3px);
  }
  .row-link:focus-visible { outline: 2px solid var(--layer-hue); outline-offset: 2px; }

  .bar { background: var(--layer-hue); }

  .body {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 15px 18px;
    min-width: 0;
  }

  .head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }

  .name {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--layer-hue);
  }

  .count {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .question {
    font-size: var(--text-body);
    color: var(--ink);
    font-weight: 500;
    max-width: 56ch;
  }

  .exemplars { display: flex; flex-wrap: wrap; gap: 6px; }

  .tech {
    font-size: var(--text-caption);
    color: var(--muted);
    border: 1px solid var(--hairline);
    padding: 2px 7px;
    border-radius: var(--radius);
    white-space: nowrap;
  }

  .compact .body { padding: 11px 14px; gap: 5px; }

  /* ------------------------------------------------------------- reveal */
  /* Rows arrive in sequence once the stack scrolls into view, and each
     layer's colour bar draws downward, so the group reads as one structure
     being assembled rather than a list that faded in.
     Without JS, or with reduced motion, everything is simply present. */
  .stack[data-reveal].armed .row {
    opacity: 0;
    transform: translateY(6px);
  }
  .stack[data-reveal].armed .bar {
    transform: scaleY(0);
    transform-origin: top center;
  }
  .stack[data-reveal].revealed .row {
    opacity: 1;
    transform: none;
    transition: opacity 420ms ease-out, transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 65ms);
  }
  .stack[data-reveal].revealed .bar {
    transform: scaleY(1);
    transition: transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 65ms + 90ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .stack[data-reveal] .row { opacity: 1; transform: none; }
    .stack[data-reveal] .bar { transform: scaleY(1); }
  }

</style>

<script is:inline>
  // Armed inline so the hidden state is applied before paint. If this script
  // never runs (JS disabled or blocked), the `armed` class is absent and the
  // stack renders normally, which matters because it is the site's main
  // navigation into the reference.
  (function () {
    var stacks = document.querySelectorAll('.stack[data-reveal]:not([data-wired])');
    if (!stacks.length) return;

    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    Array.prototype.forEach.call(stacks, function (s) {
      s.setAttribute('data-wired', '');
      if (reduced || !('IntersectionObserver' in window)) {
        s.classList.add('revealed');
        return;
      }
      s.classList.add('armed');
    });

    if (reduced || !('IntersectionObserver' in window)) return;

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('revealed');
        io.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });

    Array.prototype.forEach.call(stacks, function (s) { io.observe(s); });

    // Reveal anything already on screen without waiting for a callback, and
    // guarantee everything is shown shortly after regardless. This stack is the
    // main navigation into the reference, so it must never stay hidden because
    // an observer did not fire.
    Array.prototype.forEach.call(stacks, function (s) {
      var r = s.getBoundingClientRect();
      if (r.top < window.innerHeight && r.bottom > 0) s.classList.add('revealed');
    });

    setTimeout(function () {
      Array.prototype.forEach.call(stacks, function (s) { s.classList.add('revealed'); });
    }, 1600);
  })();
</script>
