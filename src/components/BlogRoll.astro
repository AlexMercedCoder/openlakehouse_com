---
import blogs from '../data/blogs.json';
---

<section class="blog-roll">
  <div class="blog-roll-header">
    <input type="search" id="blog-search" class="search-input" placeholder="Search blogs..." aria-label="Search blogs" />
  </div>
  <ul class="blog-list">
    {blogs.map((blog) => (
      <li class="blog-item">
        <a href={blog.url} target="_blank" rel="noopener noreferrer">
          <strong class="blog-title">{blog.title}</strong>
        </a>
        <span class="date">{blog.date}</span>
      </li>
    ))}
  </ul>
</section>

<script>
  const searchInput = document.getElementById('blog-search') as HTMLInputElement | null;
  const blogItems = document.querySelectorAll('.blog-item');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const term = (e.target as HTMLInputElement).value.toLowerCase();
      blogItems.forEach(item => {
        const title = item.querySelector('.blog-title')?.textContent?.toLowerCase() || '';
        if (title.includes(term)) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  }
</script>

<style>
  .blog-roll {
    margin: var(--spacing-20) 0;
  }

  .blog-roll-header {
    margin-bottom: var(--spacing-24);
  }

  .blog-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .blog-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: var(--spacing-16) 0;
    border-bottom: 1px solid var(--color-subtle-gray);
  }

  .blog-item:last-child {
    border-bottom: none;
  }

  .blog-list a {
    color: var(--color-midnight-black);
    text-decoration: none;
    font-size: var(--text-body-lg);
    font-weight: 500;
  }

  .blog-list a:hover {
    text-decoration: underline;
  }

  .date {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--color-faded-gray);
    white-space: nowrap;
    margin-left: var(--spacing-16);
  }
</style>
