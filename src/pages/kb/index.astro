---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const kbEntries = await getCollection('kb');
---

<Layout title="Knowledge Base">
  <div class="container section">
    <div class="kb-header">
      <div class="kb-title-block">
        <h1>Knowledge Base</h1>
        <p>Explore our carefully curated glossary.</p>
      </div>
      <input type="search" id="kb-search" class="search-input" placeholder="Search terms..." aria-label="Search terms" />
    </div>

    <div class="kb-list">
      {kbEntries.map((entry) => (
        <a href={`/kb/${entry.id}`} class="kb-item">
          <div class="kb-title">{entry.data.title}</div>
          <div class="kb-desc">{entry.data.description}</div>
          <div class="kb-meta">By {entry.data.author} • {entry.data.diagrams_included} Diagrams</div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('kb-search') as HTMLInputElement | null;
  const kbItems = document.querySelectorAll('.kb-item');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const term = (e.target as HTMLInputElement).value.toLowerCase();
      kbItems.forEach(item => {
        const title = item.querySelector('.kb-title')?.textContent?.toLowerCase() || '';
        const desc = item.querySelector('.kb-desc')?.textContent?.toLowerCase() || '';
        if (title.includes(term) || desc.includes(term)) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  }
</script>

<style>
  .kb-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--spacing-64);
    gap: var(--spacing-24);
    flex-wrap: wrap;
  }
  .kb-title-block h1 {
    margin-bottom: var(--spacing-12);
  }
  .kb-title-block p {
    color: var(--color-faded-gray);
    font-size: var(--text-body-lg);
  }
  .search-input {
    max-width: 300px;
  }
  .kb-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--spacing-24);
  }
  .kb-item {
    border: 1px solid var(--color-midnight-black);
    padding: var(--spacing-24);
    display: flex;
    flex-direction: column;
    background: var(--color-canvas-white);
    border-radius: var(--radius-sm);
  }
  .kb-item:hover {
    background: #fdfdfd;
    box-shadow: 4px 4px 0 var(--color-midnight-black);
    transform: translate(-2px, -2px);
  }
  .kb-title {
    font-family: var(--font-display);
    font-size: 24px;
    margin-bottom: var(--spacing-12);
    text-transform: uppercase;
  }
  .kb-desc {
    font-size: var(--text-body);
    color: var(--color-anchor-gray);
    margin-bottom: var(--spacing-20);
    flex-grow: 1;
  }
  .kb-meta {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--color-subtle-gray);
    text-transform: uppercase;
  }
</style>
