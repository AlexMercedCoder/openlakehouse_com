---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const kbEntries = await getCollection('kb');
  return kbEntries.map(entry => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const canonicalURL = new URL(`/kb/${entry.id}/`, Astro.site || 'https://opendatalakehouse.com');
const articleLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": entry.data.title,
  "description": entry.data.description,
  "datePublished": entry.data.date.toISOString(),
  "mainEntityOfPage": canonicalURL.toString(),
  "image": "https://opendatalakehouse.com/og-image.png",
  "author": {
    "@type": "Person",
    "@id": "https://alexmerced.com/#person",
    "name": "Alex Merced",
    "url": "https://alexmerced.com",
    "sameAs": [
      "https://whoisalexmerced.com",
      "https://alexmerced.com",
      "https://alexmerceddata.com",
      "https://www.linkedin.com/in/alexmerced"
    ]
  },
  "publisher": {
    "@type": "Organization",
    "name": "OpenDataLakehouse",
    "url": "https://opendatalakehouse.com/"
  }
};
---

<Layout title={entry.data.title} description={entry.data.description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <article class="container section">
    <header class="kb-article-header">
      <h1>{entry.data.title}</h1>
      <div class="kb-meta">
        <span>By {entry.data.author}</span>
        <span>•</span>
        <time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString()}</time>
      </div>
    </header>
    <div class="kb-content">
      <Content />
    </div>
  </article>

  <!-- Mermaid: load from CDN then convert code blocks to diagrams -->
  <script>
    async function initMermaid() {
      // @ts-ignore — dynamic CDN import, not in node_modules
      const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');

      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        themeVariables: {
          primaryColor: '#ffffff',
          primaryTextColor: '#000000',
          primaryBorderColor: '#000000',
          lineColor: '#000000',
          secondaryColor: '#f4f4f4',
          tertiaryColor: '#e8e8e8',
          background: '#ffffff',
          mainBkg: '#ffffff',
          nodeBorder: '#000000',
          clusterBkg: '#f4f4f4',
          titleColor: '#000000',
          edgeLabelBackground: '#ffffff',
          fontFamily: 'Space Mono, monospace',
        },
      });

      // Astro's Shiki highlighter renders ```mermaid fences as:
      // <pre class="astro-code" data-language="mermaid"><code><span>...</span></code></pre>
      // We extract the plain text content and replace with a <div class="mermaid">
      document.querySelectorAll('pre[data-language="mermaid"]').forEach((pre) => {
        const code = pre.querySelector('code');
        if (!code) return;
        const div = document.createElement('div');
        div.className = 'mermaid';
        // textContent from Shiki-rendered spans gives the raw diagram source
        div.textContent = code.textContent ?? '';
        pre.replaceWith(div);
      });

      await mermaid.run({ querySelector: '.mermaid' });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMermaid);
    } else {
      initMermaid();
    }
  </script>
</Layout>

<style is:global>
  .kb-article-header {
    margin-bottom: var(--spacing-64);
    border-bottom: 1px solid var(--color-midnight-black);
    padding-bottom: var(--spacing-24);
  }
  .kb-article-header h1 {
    font-size: var(--text-display-sm);
    margin-bottom: var(--spacing-12);
    text-transform: uppercase;
  }
  .kb-meta {
    font-family: var(--font-mono);
    color: var(--color-faded-gray);
    font-size: var(--text-caption);
    text-transform: uppercase;
    display: flex;
    gap: var(--spacing-12);
  }
  .kb-content {
    font-size: var(--text-body-lg);
    line-height: 1.7;
    max-width: 800px;
  }
  .kb-content h2, .kb-content h3 {
    margin-top: var(--spacing-64);
    margin-bottom: var(--spacing-24);
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 32px;
  }
  .kb-content p {
    margin-bottom: var(--spacing-24);
  }
  .kb-content a {
    text-decoration: underline;
  }
  .kb-content ul, .kb-content ol {
    margin-bottom: var(--spacing-24);
    padding-left: var(--spacing-24);
  }
  .kb-content li {
    margin-bottom: var(--spacing-12);
  }
  .kb-content pre {
    background: #f4f4f4;
    padding: var(--spacing-24);
    border: 1px solid var(--color-midnight-black);
    border-radius: var(--radius-sm);
    overflow-x: auto;
    margin-bottom: var(--spacing-36);
  }
  .kb-content code {
    font-family: var(--font-mono);
    font-size: 14px;
  }
  /* Mermaid diagram container */
  .kb-content .mermaid {
    margin: var(--spacing-36) 0;
    padding: var(--spacing-24);
    border: 2px solid var(--color-midnight-black);
    background: #ffffff;
    overflow-x: auto;
    text-align: center;
  }
  .kb-content .mermaid svg {
    max-width: 100%;
    height: auto;
  }
</style>
