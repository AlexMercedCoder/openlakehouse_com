---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <div class="container section">
    <div class="hero">
      <h1>Data Lakehouse.<br/>Apache Iceberg.<br/>Agentic Analytics.</h1>
      <p class="lead">The vendor-neutral technical publication for data engineers.</p>
      <div class="actions">
        <a href="/kb" class="btn">Knowledge Base</a>
        <a href="/blogs" class="btn-ghost">Blog Roll</a>
        <a href="/videos" class="btn-ghost">Videos</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .hero {
    text-align: left;
    max-width: 1000px;
    padding: var(--spacing-112) 0;
  }
  .hero h1 {
    font-size: 115px; /* Display SM from design system */
    line-height: 1;
    margin-bottom: var(--spacing-24);
  }
  .lead {
    font-size: var(--text-body-lg);
    color: var(--color-faded-gray);
    margin-bottom: var(--spacing-36);
    max-width: 600px;
  }
  .actions {
    display: flex;
    gap: var(--spacing-16);
  }
</style>
