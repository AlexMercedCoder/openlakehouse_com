---
import Layout from '../layouts/Layout.astro';
import LayerStack from '../components/LayerStack.astro';
import StackDiagram from '../components/StackDiagram.astro';
import TrademarkNotice from '../components/TrademarkNotice.astro';
import HomeFilmShowcase from '../components/HomeFilmShowcase.astro';
import { getCollection } from 'astro:content';
import { LAYERS } from '../data/layers';
import { COMPARISONS } from '../data/comparisons';

const entries = await getCollection('kb');
const counts: Record<string, number> = {};
for (const e of entries) counts[e.data.layer] = (counts[e.data.layer] ?? 0) + 1;

const title = 'What Is an Open Lakehouse? A Vendor-Neutral Reference';
const description =
  'What an open lakehouse is, explained without a vendor pitch: open formats on object storage, the nine layers of the stack, and how to choose at each one.';
const SITE = 'https://opendatalakehouse.com';

/**
 * Newcomer questions. Each answer is rendered on the page and reused verbatim
 * in the FAQPage JSON-LD, so the two can never disagree.
 */
const HOME_FAQ = [
  {
    q: 'What is an open lakehouse?',
    a: 'A data architecture that keeps data in open file and table formats on object storage you control, so any engine that implements those formats can read and write it. You attach engines to the data instead of loading the data into an engine.',
    href: '/what-is-an-open-lakehouse',
    link: 'Read the full definition',
  },
  {
    q: 'How is it different from a data warehouse or a data lake?',
    a: 'A data lake gives you cheap storage without guarantees, and a warehouse gives you guarantees without engine choice. A lakehouse adds transactions and schema enforcement to files on object storage, so you keep the low-cost storage and the choice of engines while gaining the guarantees.',
    href: '/compare/lakehouse-vs-warehouse-vs-lake',
    link: 'See the side-by-side comparison',
  },
  {
    q: 'What is a table format?',
    a: 'The metadata layer that turns a directory of data files into a table. It records which files make up the table right now, what the schema is, and how concurrent writers commit changes, which is what gives you transactions, schema evolution, and time travel. Apache Iceberg, Delta Lake, Apache Hudi, and Apache Paimon are table formats.',
    href: '/kb/table-format',
    link: 'Read the table format entry',
  },
  {
    q: 'What does a catalog do?',
    a: 'It tracks which tables exist, where each table\'s current metadata lives, and who is allowed to read or write them. Once more than one engine touches the same tables, the catalog is the single authority they all ask.',
    href: '/compare/catalogs',
    link: 'Compare lakehouse catalogs',
  },
  {
    q: 'Can multiple engines share the same tables?',
    a: 'Yes, and that is the main reason to build one. Spark, Trino, Flink, DuckDB, Dremio, and others can read and write the same tables as long as they implement the table format and connect through a shared catalog. There is still one copy of the data.',
    href: '/principles',
    link: 'Read the five principles',
  },
  {
    q: 'Is an open lakehouse vendor neutral?',
    a: 'The architecture is, when the formats are publicly specified, the catalog speaks an open API, and leaving costs no more than arriving. Individual products can still lock you in, so this site gives a test for each of those properties rather than taking a product\'s word for it.',
    href: '/principles',
    link: 'See the tests for openness',
  },
  {
    q: 'Where should I start?',
    a: 'Read the definition, then the reference architecture to see how the layers fit. If you learn best by doing, run the local example: it writes rows to an Iceberg table with PyIceberg and reads a snapshot back on your laptop.',
    href: '/example',
    link: 'Run the local example',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE}/#faq`,
  mainEntity: HOME_FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a, url: `${SITE}${f.href}/` },
  })),
};

/** The layer stack, bottom to top, pointing at each layer's reference page. */
const stackLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${SITE}/#layer-stack`,
  name: 'The open lakehouse layer stack',
  description: 'The nine layers of an open lakehouse, from foundations at the bottom to agents and AI at the top.',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: LAYERS.length,
  itemListElement: LAYERS.slice()
    .sort((a, b) => a.order - b.order)
    .map((l, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: l.label,
      description: l.role,
      url: `${SITE}/kb/layer/${l.id}/`,
    })),
};

/**
 * Vendor material is welcome but it is not the front door. The definitional
 * pages lead; implementation reading is clearly labelled and sits lower down.
 */
const IMPLEMENTATION_READING = [
  {
    title: 'Semantic layer: a definitive guide',
    source: 'Dremio',
    url: 'https://www.dremio.com/blog/semantic-layer-the-definitive-guide/',
  },
  {
    title: 'Apache Polaris as a catalog standard',
    source: 'Dremio',
    url: 'https://www.dremio.com/blog/apache-polaris-the-catalog-standard-for-lakehouses-and-ai/',
  },
  {
    title: 'What are table formats, and why were they needed?',
    source: 'Dremio',
    url: 'https://www.dremio.com/blog/what-are-table-formats-and-why-were-they-needed/',
  },
  {
    title: 'Open source and the data lakehouse',
    source: 'Dremio',
    url: 'https://www.dremio.com/blog/open-source-and-the-data-lakehouse/',
  },
];
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(stackLd)} />
  <!-- Hero: states the definition immediately rather than a slogan. -->
  <section class="hero">
    <div class="container hero-grid">
     <div class="hero-copy">
      <p class="eyebrow">OpenDataLakehouse</p>
      <h1 class="hero-title">What is an open lakehouse?</h1>
      <p class="hero-sub">A vendor-neutral reference.</p>
      <p class="hero-def">
        A data architecture that stores data in <strong>open file and table formats</strong>
        on commodity object storage, so that <strong>any compliant engine</strong> can read
        and write it without vendor lock-in.
      </p>
      <div class="hero-actions">
        <a href="/what-is-an-open-lakehouse" class="btn">Start with the definition</a>
        <a href="/architecture" class="btn-ghost">See the architecture</a>
        <a href="/example" class="btn-ghost">Run a local example</a>
      </div>
      <dl class="hero-stats">
        <div><dt>Reference entries</dt><dd>{entries.length}</dd></div>
        <div><dt>Architecture layers</dt><dd>{LAYERS.length}</dd></div>
        <div><dt>Comparisons</dt><dd>{COMPARISONS.length}</dd></div>
      </dl>
     </div>
     <div class="hero-figure"><StackDiagram /></div>
    </div>
  </section>

  <HomeFilmShowcase eyebrow="The Iceberg Open Lakehouse" heading="The lakehouse, set to music" intro="An eight-minute visual tour of Apache Iceberg, open storage, catalogs, engines, and the architecture that keeps your data portable." films={[{
    title: 'The Iceberg Open Lakehouse',
    description: 'A beat-synced explainer about the open table format and the interoperable lakehouse around it.',
    src: '/the-iceberg-open-lakehouse.mp4',
    poster: '/the-iceberg-open-lakehouse-poster.jpg',
    runtime: '7:50',
  }]} />

  <!-- The stack is the site's organising idea, so it appears above the fold-ish. -->
  <section class="container section-sm">
    <div class="sec-head">
      <div>
        <h2>The stack, one layer at a time</h2>
        <p class="lead">
          An open lakehouse is assembled from layers, each with one job and several
          implementations. Any one of them can be replaced without disturbing the others,
          which is the entire point of the architecture.
        </p>
      </div>
    </div>
    <LayerStack counts={counts} />
    <div style="margin-top: var(--sp-5);"><TrademarkNotice /></div>
  </section>

  <section class="container section-sm">
    <div class="sec-head">
      <div>
        <h2>Start here</h2>
        <p class="lead">Four pages that cover the whole subject, in the order they make sense.</p>
      </div>
    </div>
    <div class="path">
      <a href="/what-is-an-open-lakehouse" class="path-step">
        <span class="step-n">01</span>
        <span class="step-name">What it is</span>
        <span class="step-desc">The definition, the three claims inside the term, and what it replaced</span>
      </a>
      <a href="/principles" class="path-step">
        <span class="step-n">02</span>
        <span class="step-name">Principles</span>
        <span class="step-desc">Five commitments that make an architecture open, each with a test you can run</span>
      </a>
      <a href="/architecture" class="path-step">
        <span class="step-n">03</span>
        <span class="step-name">Architecture</span>
        <span class="step-desc">Every layer, the options at each, and where the clean model blurs</span>
      </a>
      <a href="/history" class="path-step">
        <span class="step-n">04</span>
        <span class="step-name">History</span>
        <span class="step-desc">Why the architecture is shaped this way, one failure at a time</span>
      </a>
    </div>
  </section>

  <section class="container section-sm">
    <div class="sec-head">
      <div>
        <h2>The choices, side by side</h2>
        <p class="lead">
          Each layer has several viable options. These comparisons lead with the table.
        </p>
      </div>
      <a href="/compare" class="sec-link">All comparisons</a>
    </div>
    <div class="compare-grid">
      {COMPARISONS.map((c) => (
        <a href={`/compare/${c.slug}`} class="compare-card" style={`--layer-hue: var(--layer-${c.layer});`}>
          <span class="layer-chip" style={`--layer-hue: var(--layer-${c.layer});`}>{c.layer}</span>
          <span class="compare-title">{c.title}</span>
          <span class="compare-answer">{c.answer}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section-sm">
    <div class="sec-head">
      <div>
        <h2>Look something up</h2>
        <p class="lead">
          {entries.length} in-depth entries, each mapped to the layer it belongs to, plus a
          one-line glossary for when that is all you need.
        </p>
      </div>
      <a href="/kb" class="sec-link">Browse the library</a>
    </div>
    <div class="lookup">
      <a href="/kb" class="lookup-card">
        <span class="lookup-title">Reference library</span>
        <span class="lookup-desc">Full entries, several thousand words each, grouped by layer</span>
      </a>
      <a href="/glossary" class="lookup-card">
        <span class="lookup-title">Glossary</span>
        <span class="lookup-desc">Every term defined in one line, on a single page</span>
      </a>
      <a href="/faq" class="lookup-card">
        <span class="lookup-title">FAQ</span>
        <span class="lookup-desc">Direct answers to the questions that come up most</span>
      </a>
    </div>
  </section>

  <section class="container section-sm" id="faq" aria-labelledby="home-faq-heading">
    <div class="sec-head">
      <div>
        <h2 id="home-faq-heading">Questions newcomers ask</h2>
        <p class="lead">Short answers, each with a link to the page that covers it in full.</p>
      </div>
      <a href="/faq" class="sec-link">Full FAQ</a>
    </div>
    <div class="home-faq">
      {HOME_FAQ.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
          <a href={f.href} class="faq-link">{f.link}</a>
        </div>
      ))}
    </div>
  </section>

  <section class="container section-sm">
    <div class="sec-head">
      <div>
        <h2>Implementation reading</h2>
        <p class="lead">
          Written by vendors, listed here because the technical content is useful. Nothing
          on this site is a recommendation to buy anything.
        </p>
      </div>
    </div>
    <ul class="vendor-list">
      {IMPLEMENTATION_READING.map((r) => (
        <li>
          <a href={r.url} target="_blank" rel="noopener noreferrer">
            <span class="v-title">{r.title}</span>
            <span class="v-source">{r.source}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="vendor-note">
      More reading, including independent sources, is collected in the
      <a href="/blogs">blog roll</a>, <a href="/videos">video roll</a>, and
      <a href="/books">book roll</a>.
    </p>
  </section>
</Layout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .hero-copy { min-width: 0; }
  .hero-figure { min-width: 0; }
  /* Below this width the diagram would be too small to read, so it moves
     under the copy at full width rather than shrinking further. */
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-figure { max-width: 480px; }
  }

  .hero {
    padding: clamp(48px, 9vw, 104px) 0 clamp(40px, 7vw, 76px);
    border-bottom: 1px solid var(--hairline);
  }
  .hero-title {
    font-family: var(--font-display);
    /* The question runs longer than the old two-word title, so it sets smaller. */
    font-size: clamp(2.5rem, 1.4rem + 4.4vw, 5.25rem);
    line-height: 0.9;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    margin: 14px 0 12px;
  }
  .hero-sub {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 26px;
  }

  .home-faq { display: grid; gap: 3px; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); }
  .faq-item {
    display: flex; flex-direction: column; gap: 9px;
    padding: 20px; background: var(--surface); border: 1px solid var(--hairline);
  }
  .faq-item h3 { font-size: var(--text-body); }
  .faq-item p { font-size: var(--text-small); color: var(--ink-soft); }
  .faq-link {
    margin-top: auto; font-size: var(--text-small); font-weight: 600;
    text-decoration: underline;
  }
  .hero-def {
    font-size: var(--text-lead);
    line-height: 1.45;
    max-width: 60ch;
    color: var(--ink-soft);
  }
  .hero-def strong { color: var(--ink); font-weight: 600; }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }

  .hero-stats {
    display: flex; flex-wrap: wrap; gap: 40px;
    margin-top: 44px; padding-top: 24px;
    border-top: 1px solid var(--hairline);
  }
  .hero-stats div { display: flex; flex-direction: column-reverse; gap: 3px; }
  .hero-stats dd {
    font-family: var(--font-display); font-size: 40px; line-height: 1;
    letter-spacing: 0.02em; font-variant-numeric: tabular-nums;
  }
  .hero-stats dt {
    font-family: var(--font-mono); font-size: var(--text-caption);
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
  }

  .sec-head {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: var(--sp-5); flex-wrap: wrap; margin-bottom: var(--sp-5);
  }
  .sec-head h2 { margin-bottom: 9px; }
  .sec-link {
    font-family: var(--font-mono); font-size: var(--text-caption);
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
    white-space: nowrap;
  }
  .sec-link:hover { color: var(--ink); text-decoration: underline; }

  .path { display: grid; gap: 3px; grid-template-columns: repeat(auto-fit, minmax(232px, 1fr)); }
  .path-step {
    display: flex; flex-direction: column; gap: 7px;
    padding: 20px; background: var(--surface); border: 1px solid var(--hairline);
  }
  .path-step:hover { border-color: var(--ink); }
  .step-n {
    font-family: var(--font-mono); font-size: var(--text-caption);
    color: var(--muted); font-variant-numeric: tabular-nums;
  }
  .step-name { font-weight: 700; font-size: var(--text-h3); }
  .step-desc { font-size: var(--text-small); color: var(--muted); }

  .compare-grid { display: grid; gap: 3px; grid-template-columns: repeat(auto-fit, minmax(285px, 1fr)); }
  .compare-card {
    display: flex; flex-direction: column; gap: 10px;
    padding: 20px; background: var(--surface);
    border: 1px solid var(--hairline); border-top: 4px solid var(--layer-hue);
  }
  .compare-card:hover { border-color: var(--layer-hue); }
  .compare-title { font-weight: 700; font-size: var(--text-body); }
  .compare-answer { font-size: var(--text-small); color: var(--muted); }

  .lookup { display: grid; gap: 3px; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
  .lookup-card {
    display: flex; flex-direction: column; gap: 6px;
    padding: 20px; background: var(--surface); border: 1px solid var(--hairline);
  }
  .lookup-card:hover { border-color: var(--ink); }
  .lookup-title { font-weight: 700; font-size: var(--text-h3); }
  .lookup-desc { font-size: var(--text-small); color: var(--muted); }

  .vendor-list { list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .vendor-list a {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 16px; flex-wrap: wrap;
    padding: 13px 16px; background: var(--surface); border: 1px solid var(--hairline);
    font-size: var(--text-small);
  }
  .vendor-list a:hover { border-color: var(--ink); }
  .v-title { font-weight: 600; }
  .v-source {
    font-family: var(--font-mono); font-size: var(--text-caption);
    color: var(--muted); text-transform: uppercase; letter-spacing: 0.07em;
  }
  .vendor-note { margin-top: var(--sp-4); font-size: var(--text-small); color: var(--muted); }
  .vendor-note a { text-decoration: underline; }
</style>
