---
import Layout from '../layouts/Layout.astro';
import LayerStack from '../components/LayerStack.astro';
import { getCollection } from 'astro:content';
import { LAYERS } from '../data/layers';
import { COMPARISONS } from '../data/comparisons';

const entries = await getCollection('kb');
const counts: Record<string, number> = {};
for (const e of entries) counts[e.data.layer] = (counts[e.data.layer] ?? 0) + 1;

const description =
  'A vendor-neutral reference for open lakehouse architecture: what an open lakehouse is, how its layers fit together, and how to choose at each one.';

/**
 * Vendor material is welcome but it is not the front door. The definitional
 * pages lead; implementation reading is clearly labelled and sits lower down.
 */
const IMPLEMENTATION_READING = [
  {
    title: 'Semantic layer: a definitive guide',
    source: 'Dremio',
    url: 'https://www.dremio.com/blog/semantic-layer-the-definitive-guide/',
  },
  {
    title: 'Apache Polaris as a catalog standard',
    source: 'Dremio',
    url: 'https://www.dremio.com/blog/apache-polaris-the-catalog-standard-for-lakehouses-and-ai/',
  },
  {
    title: 'What are table formats, and why were they needed?',
    source: 'Dremio',
    url: 'https://www.dremio.com/blog/what-are-table-formats-and-why-were-they-needed/',
  },
  {
    title: 'Open source and the data lakehouse',
    source: 'Dremio',
    url: 'https://www.dremio.com/blog/open-source-and-the-data-lakehouse/',
  },
];
---

<Layout title="Open lakehouse architecture, explained" description={description}>
  <!-- Hero: states the definition immediately rather than a slogan. -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Vendor-neutral reference</p>
      <h1 class="hero-title">The open<br />lakehouse</h1>
      <p class="hero-def">
        A data architecture that stores data in <strong>open file and table formats</strong>
        on commodity object storage, so that <strong>any compliant engine</strong> can read
        and write it without vendor lock-in.
      </p>
      <div class="hero-actions">
        <a href="/what-is-an-open-lakehouse" class="btn">Start with the definition</a>
        <a href="/architecture" class="btn-ghost">See the architecture</a>
      </div>
      <dl class="hero-stats">
        <div><dt>Reference entries</dt><dd>{entries.length}</dd></div>
        <div><dt>Architecture layers</dt><dd>{LAYERS.length}</dd></div>
        <div><dt>Vendors promoted</dt><dd>0</dd></div>
      </dl>
    </div>
  </section>

  <!-- The stack is the site's organising idea, so it appears above the fold-ish. -->
  <section class="container section-sm">
    <div class="sec-head">
      <div>
        <h2>The stack, one layer at a time</h2>
        <p class="lead">
          An open lakehouse is assembled from layers, each with one job and several
          implementations. Any one of them can be replaced without disturbing the others,
          which is the entire point of the architecture.
        </p>
      </div>
    </div>
    <LayerStack counts={counts} />
  </section>

  <section class="container section-sm">
    <div class="sec-head">
      <div>
        <h2>Start here</h2>
        <p class="lead">Four pages that cover the whole subject, in the order they make sense.</p>
      </div>
    </div>
    <div class="path">
      <a href="/what-is-an-open-lakehouse" class="path-step">
        <span class="step-n">01</span>
        <span class="step-name">What it is</span>
        <span class="step-desc">The definition, the three claims inside the term, and what it replaced</span>
      </a>
      <a href="/principles" class="path-step">
        <span class="step-n">02</span>
        <span class="step-name">Principles</span>
        <span class="step-desc">Five commitments that make an architecture open, each with a test you can run</span>
      </a>
      <a href="/architecture" class="path-step">
        <span class="step-n">03</span>
        <span class="step-name">Architecture</span>
        <span class="step-desc">Every layer, the options at each, and where the clean model blurs</span>
      </a>
      <a href="/history" class="path-step">
        <span class="step-n">04</span>
        <span class="step-name">History</span>
        <span class="step-desc">Why the architecture is shaped this way, one failure at a time</span>
      </a>
    </div>
  </section>

  <section class="container section-sm">
    <div class="sec-head">
      <div>
        <h2>The choices, side by side</h2>
        <p class="lead">
          Each layer has several viable options. These comparisons lead with the table.
        </p>
      </div>
      <a href="/compare" class="sec-link">All comparisons</a>
    </div>
    <div class="compare-grid">
      {COMPARISONS.map((c) => (
        <a href={`/compare/${c.slug}`} class="compare-card" style={`--layer-hue: var(--layer-${c.layer});`}>
          <span class="layer-chip" style={`--layer-hue: var(--layer-${c.layer});`}>{c.layer}</span>
          <span class="compare-title">{c.title}</span>
          <span class="compare-answer">{c.answer}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section-sm">
    <div class="sec-head">
      <div>
        <h2>Look something up</h2>
        <p class="lead">
          {entries.length} in-depth entries, each mapped to the layer it belongs to, plus a
          one-line glossary for when that is all you need.
        </p>
      </div>
      <a href="/kb" class="sec-link">Browse the library</a>
    </div>
    <div class="lookup">
      <a href="/kb" class="lookup-card">
        <span class="lookup-title">Reference library</span>
        <span class="lookup-desc">Full entries, several thousand words each, grouped by layer</span>
      </a>
      <a href="/glossary" class="lookup-card">
        <span class="lookup-title">Glossary</span>
        <span class="lookup-desc">Every term defined in one line, on a single page</span>
      </a>
      <a href="/faq" class="lookup-card">
        <span class="lookup-title">FAQ</span>
        <span class="lookup-desc">Direct answers to the questions that come up most</span>
      </a>
    </div>
  </section>

  <section class="container section-sm">
    <div class="sec-head">
      <div>
        <h2>Implementation reading</h2>
        <p class="lead">
          Written by vendors, listed here because the technical content is useful. Nothing
          on this site is a recommendation to buy anything.
        </p>
      </div>
    </div>
    <ul class="vendor-list">
      {IMPLEMENTATION_READING.map((r) => (
        <li>
          <a href={r.url} target="_blank" rel="noopener noreferrer">
            <span class="v-title">{r.title}</span>
            <span class="v-source">{r.source}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="vendor-note">
      More reading, including independent sources, is collected in the
      <a href="/blogs">blog roll</a>, <a href="/videos">video roll</a>, and
      <a href="/books">book roll</a>.
    </p>
  </section>
</Layout>

<style>
  .hero {
    padding: clamp(48px, 9vw, 104px) 0 clamp(40px, 7vw, 76px);
    border-bottom: 1px solid var(--hairline);
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 0.86;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    margin: 14px 0 26px;
  }
  .hero-def {
    font-size: var(--text-lead);
    line-height: 1.45;
    max-width: 60ch;
    color: var(--ink-soft);
  }
  .hero-def strong { color: var(--ink); font-weight: 600; }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }

  .hero-stats {
    display: flex; flex-wrap: wrap; gap: 40px;
    margin-top: 44px; padding-top: 24px;
    border-top: 1px solid var(--hairline);
  }
  .hero-stats div { display: flex; flex-direction: column-reverse; gap: 3px; }
  .hero-stats dd {
    font-family: var(--font-display); font-size: 40px; line-height: 1;
    letter-spacing: 0.02em; font-variant-numeric: tabular-nums;
  }
  .hero-stats dt {
    font-family: var(--font-mono); font-size: var(--text-caption);
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
  }

  .sec-head {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: var(--sp-5); flex-wrap: wrap; margin-bottom: var(--sp-5);
  }
  .sec-head h2 { margin-bottom: 9px; }
  .sec-link {
    font-family: var(--font-mono); font-size: var(--text-caption);
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
    white-space: nowrap;
  }
  .sec-link:hover { color: var(--ink); text-decoration: underline; }

  .path { display: grid; gap: 3px; grid-template-columns: repeat(auto-fit, minmax(232px, 1fr)); }
  .path-step {
    display: flex; flex-direction: column; gap: 7px;
    padding: 20px; background: var(--surface); border: 1px solid var(--hairline);
  }
  .path-step:hover { border-color: var(--ink); }
  .step-n {
    font-family: var(--font-mono); font-size: var(--text-caption);
    color: var(--muted); font-variant-numeric: tabular-nums;
  }
  .step-name { font-weight: 700; font-size: var(--text-h3); }
  .step-desc { font-size: var(--text-small); color: var(--muted); }

  .compare-grid { display: grid; gap: 3px; grid-template-columns: repeat(auto-fit, minmax(285px, 1fr)); }
  .compare-card {
    display: flex; flex-direction: column; gap: 10px;
    padding: 20px; background: var(--surface);
    border: 1px solid var(--hairline); border-top: 4px solid var(--layer-hue);
  }
  .compare-card:hover { border-color: var(--layer-hue); }
  .compare-title { font-weight: 700; font-size: var(--text-body); }
  .compare-answer { font-size: var(--text-small); color: var(--muted); }

  .lookup { display: grid; gap: 3px; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
  .lookup-card {
    display: flex; flex-direction: column; gap: 6px;
    padding: 20px; background: var(--surface); border: 1px solid var(--hairline);
  }
  .lookup-card:hover { border-color: var(--ink); }
  .lookup-title { font-weight: 700; font-size: var(--text-h3); }
  .lookup-desc { font-size: var(--text-small); color: var(--muted); }

  .vendor-list { list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .vendor-list a {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 16px; flex-wrap: wrap;
    padding: 13px 16px; background: var(--surface); border: 1px solid var(--hairline);
    font-size: var(--text-small);
  }
  .vendor-list a:hover { border-color: var(--ink); }
  .v-title { font-weight: 600; }
  .v-source {
    font-family: var(--font-mono); font-size: var(--text-caption);
    color: var(--muted); text-transform: uppercase; letter-spacing: 0.07em;
  }
  .vendor-note { margin-top: var(--sp-4); font-size: var(--text-small); color: var(--muted); }
  .vendor-note a { text-decoration: underline; }
</style>
