---
import Layout from '../../layouts/Layout.astro';
import VideoRoll from '../../components/VideoRoll.astro';
---

<Layout title="Lakehouse and AI Videos" description="Recent videos from Alex Merced's Data & AI YouTube channel on Apache Iceberg, lakehouse streaming and AI news, searchable by title, each linking to YouTube.">
  <div class="container section">
    <div class="page-header">
      <h1>Videos</h1>
      <p>Latest from Alex Merced Data</p>
    </div>
    <VideoRoll />
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: var(--spacing-64);
  }
  .page-header p {
    color: var(--color-faded-gray);
    font-size: var(--text-body-lg);
  }
</style>
